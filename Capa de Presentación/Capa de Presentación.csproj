<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>Capa_de_Presentación</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>ICONO-SOFTWARE.ico</ApplicationIcon>
		<StartupObject>Capa_de_Presentación.Program</StartupObject>
		<AssemblyName>Sistema Contable</AssemblyName>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Formularios Luiss\j1jmqutt.lwc~" />
	  <None Remove="Formularios Luiss\jaj2gnb4.yzy~" />
	  <None Remove="Resources\haarcascade_frontalface_default.xml" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="bin\Debug\net8.0-windows\haarcascade_frontalface_default.xml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="ICONO-SOFTWARE.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="aSystem.Windows.Forms" Version="1.0.0" />
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
		<PackageReference Include="Spire.PDF" Version="11.11.1" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
		<PackageReference Include="QuestPDF" Version="2025.7.4" />
		<PackageReference Include="ZedGraph" Version="5.2.1" />
	</ItemGroup>


	<ItemGroup>
		<Compile Update="Formularios Ewin\Inicio de sesión.cs">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
		  <DesignTimeSharedInput>True</DesignTimeSharedInput>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Formularios Diego\Certificados_De_Depósito.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Formularios Ewin\Inicio de sesión.resx">
		  <Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Formularios Luiss\BancosTransferenciaEntreCuentas.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Formularios Luiss\Ventana_Principal_Sacerdotes y Empleados.resx">
		  <Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Capa de acceso de datos\Capa de acceso de datos.csproj" />
		<ProjectReference Include="..\Capa de procesamiento de datos\Capa de procesamiento de datos.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

</Project>